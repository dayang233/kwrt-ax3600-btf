CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_xiaomi_ax3600=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_UBI=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# ---- kernel BTF: 让 fentry/fexit 可用，honk 的 UDP trace 才能挂上 ----
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_BTF=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
# CONFIG_KERNEL_DEBUG_INFO_SPLIT is not set

# ---- honk ----
CONFIG_PACKAGE_honk=y
CONFIG_PACKAGE_luci-app-honk=y

# ---- 只留上网相关，去掉默认捆绑的代理插件 ----
# CONFIG_PACKAGE_luci-app-passwall is not set
# CONFIG_PACKAGE_luci-app-istorex is not set
# CONFIG_PACKAGE_sing-box is not set
