CONFIG_TARGET_qualcommax=y
CONFIG_TARGET_qualcommax_ipq807x=y
CONFIG_TARGET_qualcommax_ipq807x_DEVICE_xiaomi_ax3600=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_UBI=y
CONFIG_TARGET_ROOTFS_INITRAMFS=y

# ---- kernel BTF: 让 fentry/fexit 可用，honk 的 UDP trace 才能挂上 ----
CONFIG_KERNEL_DEBUG_INFO=y
CONFIG_KERNEL_DEBUG_INFO_BTF=y
# CONFIG_KERNEL_DEBUG_INFO_REDUCED is not set
# CONFIG_KERNEL_DEBUG_INFO_SPLIT is not set

# ---- honk 依赖的内核能力 ----
CONFIG_KERNEL_XDP_SOCKETS=y
CONFIG_KERNEL_BPF_EVENTS=y

# ---- honk（用内核自带 BTF，不再需要外挂 vmlinux-btf）----
CONFIG_PACKAGE_honk=y
CONFIG_PACKAGE_luci-app-honk=y
CONFIG_HONK_USE_KERNEL_BTF=y
# CONFIG_HONK_USE_VMLINUX_BTF is not set

# ---- 中文界面 + 常用工具 ----
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y
CONFIG_PACKAGE_curl=y

# Explicit cgroup, namespace and UDP native receive trace dependencies.
CONFIG_KERNEL_CGROUPS=y
CONFIG_KERNEL_CGROUP_BPF=y
CONFIG_KERNEL_NAMESPACES=y
CONFIG_KERNEL_NET_NS=y
CONFIG_KERNEL_FTRACE=y
CONFIG_KERNEL_FUNCTION_TRACER=y
CONFIG_KERNEL_DYNAMIC_FTRACE=y
CONFIG_KERNEL_KPROBES=y
CONFIG_PACKAGE_kmod-nft-queue=y
CONFIG_PACKAGE_kmod-sched-bpf=y
CONFIG_PACKAGE_kmod-veth=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_tc-full=y


# Mandatory subset of upstream seeds/qualcommax-nss-wifi.seed.
CONFIG_PACKAGE_kmod-nss-wifi-drv=y
CONFIG_ATH11K_NSS_WIFI=y
CONFIG_PACKAGE_wpad-openssl=y
# CONFIG_PACKAGE_wpad-basic-mbedtls is not set
CONFIG_PACKAGE_nss-firmware=y
CONFIG_PACKAGE_nss-firmware-ipq807x=y
CONFIG_NSS_FIRMWARE_VERSION_12_5=y
# CONFIG_NSS_FIRMWARE_VERSION_11_4 is not set
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_uhttpd=y

CONFIG_CCACHE=y

CONFIG_PACKAGE_conntrack=y
